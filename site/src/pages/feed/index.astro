---
import Section from '../../layouts/Section.astro';
import SectionGrid from '../../components/section/SectionGrid.astro';
import FeedSlip from '../../components/section/FeedSlip.astro';
import OwnerOnly from '../../components/private/OwnerOnly.astro';
import InlineEdit from '../../components/private/editor/InlineEdit';
import PrivateShelf from '../../components/private/PrivateShelf';
import '../../styles/editor.css';
import { index, feedPosts } from '../../lib/content';
const idx = await index();
const posts = feedPosts(idx);
---
<Section quiet preset={{ mode: 'thought' }} title="Feed" description="Short notes, in order." feeds={[{ title: 'Feed', href: '/feed/rss.xml' }]} action={{ label: 'New note', compose: 'feed' }}>
  {posts.length === 0 && <p class="muted">Quiet so far.</p>}
  <OwnerOnly><PrivateShelf client:only="preact" type="feed" /></OwnerOnly>
  <div data-shelf-static>
  <SectionGrid variant="slips">
    {posts.map((p) => (
      <li>
        <div data-article={p.data.id}><FeedSlip post={p} angle /></div>
        <OwnerOnly><InlineEdit client:only="preact" recordId={p.data.id} articleSelector={`[data-article="${p.data.id}"]`} title={p.data.title ?? p.body.replace(/[#>*_`\[\]!]/g, "").trim().slice(0, 40)} type="feed" /></OwnerOnly>
      </li>
    ))}
  </SectionGrid>
  </div>
</Section>
