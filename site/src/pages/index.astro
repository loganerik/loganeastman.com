---
import Base from '../layouts/Base.astro';
import Wall from '../components/wall/Wall.astro';
import { index } from '../lib/content';
import { wallCandidates } from '../lib/wall/candidates';
import identity from '@theme/identity';
const idx = await index();
const tiles = wallCandidates(idx);
---
<Base>
  <div class="wrap home">
    <p class="home__tag mono muted">{identity.site.tagline}</p>
    {tiles.length === 0 ? <p class="muted">The wall is empty. Capture something.</p> : <Wall tiles={tiles} />}
  </div>
</Base>
<style>
  .home { padding-top: var(--space-5); }
  .home__tag { margin-bottom: var(--space-4); }
</style>
