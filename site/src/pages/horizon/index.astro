---
import Section from '../../layouts/Section.astro';
import Clip from '../../components/art/Clip.astro';
import { index } from '../../lib/content';
import { horizon } from '../../lib/horizon';
import { urlFor } from '../../lib/urls';
import { fmtDate, fmtMonth, today } from '../../lib/dates';
import { restingAngle } from '../../lib/artwork';
const idx = await index();
const groups = horizon(idx, today());
const labels: Record<string, string> = { theatrical_limited: 'Limited release', theatrical: 'In theaters', digital: 'Digital', physical: 'Physical', tv: 'On TV', episode: 'Next episode', premiere: 'Premiere' };
const n = groups.reduce((s, g) => s + g.entries.length, 0);
---
<Section title="Horizon" count={n} description="What's coming, under its next confirmed release.">
  {n === 0 && <p class="muted">Nothing on the horizon yet.</p>}
  {groups.map((g) => (
    <section class="month">
      <div class="rule-label"><span>{fmtMonth(g.month + '-01')}</span></div>
      <ol class="hz">
        {g.entries.map((e) => (
          <li class="hz__row card" style={`--angle:${restingAngle(e.item.data.id, 'text')}deg`}>
            <a class="hz__art" href={urlFor(e.item)} tabindex="-1" aria-hidden="true"><Clip record={e.item} context="horizon" decorative /></a>
            <div class="hz__text">
              <p class="mono"><time datetime={e.date}>{fmtDate(e.date, { weekday: 'short', month: 'short', day: 'numeric' })}</time> <span class="muted">· {labels[e.kind] ?? e.kind}</span></p>
              <h3 class="hz__title"><a href={urlFor(e.item)}>{e.item.data.title}</a></h3>
              {e.why && <p class="hz__why">{e.why}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Section>
<style>
  .month { margin-bottom: var(--space-6); }
  .hz { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: 0; }
  .hz__row { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--rule-soft); align-items: center; }
  @media (min-width: 720px) { .hz__row { grid-template-columns: 140px minmax(0, 1fr); } }
  .hz__art { text-decoration: none; }
  .hz__title { font-size: var(--step-1); font-weight: 500; margin: var(--space-1) 0; }
  .hz__title a { text-decoration: none; }
  .hz__title a:hover { text-decoration: underline; }
  .hz__why { max-width: 56ch; }
</style>
