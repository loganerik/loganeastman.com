---
import type { WallTile } from '../../lib/wall/candidates';
import Clip from '../art/Clip.astro';
import { placementFor } from '../../lib/wall/arrange';
import Sunburst from '../forms/Sunburst.astro';
import Skyline from '../forms/Skyline.astro';
interface Props { tile: WallTile }
const { tile: t } = Astro.props;
const pl = placementFor(t.id, t.band, 0);
const textSize = t.kind === 'thought' ? ((t.words ?? 0) <= 6 ? 'xs' : (t.words ?? 0) <= 14 ? 's' : 'm') : undefined;
const textOnly = t.kind === 'thought' || t.kind === 'queue' || (t.kind === 'piece' && !(t.record.data as { artwork?: unknown }).artwork) || t.kind === 'review';
---
<li class={`tile tile--${t.kind} ${t.shape ? 'tile--' + t.shape : ''}`} data-tile={t.id} data-band={t.band} data-list={t.listId} data-size={textSize} data-shape={t.shape} data-kind={t.kind} style={`--c:${t.span.c};--r:${t.span.r};--angle:${pl.angle}deg;--dx:${pl.dx}%;--dy:${pl.dy}%`}>
  <a class="tile__link" href={t.href}>
    <span class="vh">{t.kind === 'thought' ? 'Note' : t.kind === 'queue' ? 'List' : t.kind === 'review' ? 'Review' : t.kind === 'piece' ? 'Writing' : ''}: {t.title}</span>
    {t.kind === 'thought' && t.shape === 'stepped' && !t.attached ? (
      <span class="clip clip--shape stepped tile__frame tile__frame--thought" aria-hidden="true"><span class="tile__text">{t.text}</span></span>
    ) : t.kind === 'thought' && t.attached ? (
      <span class="clip clip--shape slip slip--fit tile__slip tile__slip--attached" aria-hidden="true"><span class="tile__attached"><Clip record={t.attached} context="list" decorative sizes="20vw" /></span><span class="tile__text">{t.text}</span></span>
    ) : t.kind === 'thought' ? (
      <span class="clip clip--shape slip slip--fit tile__slip" aria-hidden="true"><span class="tile__text">{t.text}</span></span>
    ) : t.kind === 'queue' && t.shape === 'arch' ? (
      <span class="clip clip--shape tile__arch tile__arch--list" aria-hidden="true">
        <span class={`tile__arch-window ${t.picks?.length ? 'tile__arch-window--picks' : ''}`}>{t.picks?.length ? t.picks.map((p, i) => <span class="tile__peek" style={`--i:${i};--n:${t.picks!.length}`}><Clip record={p} context="wall" decorative sizes="18vw" /></span>) : <Skyline />}</span>
        <span class="tile__arch-plate"><span class="tile__arch-title">{t.title}</span></span>
      </span>
    ) : t.kind === 'queue' && t.shape === 'stepped' ? (
      <span class="clip clip--shape stepped tile__frame tile__frame--list" aria-hidden="true"><span class="tile__frame-inner"><Sunburst class="tile__frame-orn" width={40} /><span class="tile__frame-title">{t.title}</span>{t.picks?.length ? <span class="tile__strip">{t.picks.map((p) => <Clip record={p} context="wall" decorative sizes="8vw" />)}</span> : <span class="mono tile__kicker">{t.caption}</span>}</span></span>
    ) : t.kind === 'queue' && t.shape === 'slip' ? (
      <span class="clip clip--shape slip slip--ink slip--fit tile__slip tile__slip--list" aria-hidden="true"><span class="tile__slip-title">{t.title}</span><span class="mono tile__count">{t.count} on it</span></span>
    ) : t.kind === 'queue' ? (
      <span class={`clip clip--shape seal ${t.tone === 'green' ? 'seal--green' : 'seal--pink'} tile__seal`} aria-hidden="true"><span><Sunburst class="tile__seal-orn" width={48} /><span class="tile__seal-title">{t.title}</span></span></span>
    ) : textOnly && t.shape === 'arch' ? (
      <span class="clip clip--shape tile__arch" aria-hidden="true"><span class="tile__arch-window"><Skyline /></span><span class="tile__arch-plate"><span class="tile__arch-title">{t.title}</span></span></span>
    ) : textOnly ? (
      <span class="clip clip--shape stepped tile__frame" aria-hidden="true"><span class="tile__frame-inner"><Sunburst class="tile__frame-orn" width={40} /><span class="mono tile__kicker">{t.caption}</span><span class="tile__frame-title">{t.title}</span></span></span>
    ) : (
      <Clip record={t.record} context="wall" decorative sizes="(max-width: 600px) 50vw, (max-width: 900px) 25vw, 18vw" />
    )}
    <span class="tile__cap mono" aria-hidden="true">{textOnly ? '' : t.title}{textOnly ? '' : ' · '}{t.caption}</span>
  </a>
</li>
