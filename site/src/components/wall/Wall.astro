---
// The home wall. SSR renders the canonical order with seed 0; wall-client.ts reshuffles gently per visit.
import type { WallTile } from '../../lib/wall/candidates';
import WallTile from './WallTile.astro';
import Pet from '../art/Pet.astro';
import identity from '@theme/identity';
interface Props { tiles: WallTile[] }
const { tiles } = Astro.props;
const units = tiles.reduce((s, t) => s + t.span.c * t.span.r, 0);
---
<ul class="wall" data-wall data-perturbation={identity.wall.perturbation} data-picks-min={identity.wall.picksPerList[0]} data-picks-max={identity.wall.picksPerList[1]} data-pet-ratio={identity.wall.petRatio} style={`--units:${units}`} aria-label="Recent things">
  {tiles.map((t) => <WallTile tile={t} />)}
  {identity.placements.wall.map((p, i) => (
    <li class="wall__pet" data-pet-after={p.after} data-side={p.side} data-first={i === 0 ? '' : undefined} aria-hidden="true" style={`--angle:${(i % 2 ? -1 : 1) * (1 + (i % 3))}deg`}><Pet who={p.who} size="l" flip={p.side === 'left'} /></li>
  ))}
</ul>
<noscript><style>.wall { visibility: visible !important; }</style></noscript>
<script src="./wall-client.ts"></script>
<style is:global>
  .wall { --cols: 2; --wall-gap: clamp(1rem, 3vw, 2.5rem); overflow: visible; padding: 2% 3%; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); grid-auto-rows: var(--unit); grid-auto-flow: dense; gap: var(--wall-gap); container-type: inline-size; --unit: calc((100cqw - (var(--cols) - 1) * var(--wall-gap)) / var(--cols)); min-height: calc(ceil(var(--units) / var(--cols)) * (var(--unit) + var(--wall-gap))); visibility: hidden; }
  .wall[data-arranged] { visibility: visible; }
  @media (min-width: 700px) { .wall { --cols: 3; } }
  @media (min-width: 1000px) { .wall { --cols: 4; } }
  @media (min-width: 1500px) { .wall { --cols: 5; } }
  .tile { grid-column: span min(var(--c), var(--cols)); grid-row: span var(--r); position: relative; min-width: 0; }
  @media (max-width: 599px) { .tile { grid-column: span min(var(--c), 2); grid-row: span min(var(--r), 2); } }
  .tile__link { display: grid; place-items: center; width: 100%; height: 100%; text-decoration: none; color: inherit; transform: translate(var(--dx, 0%), var(--dy, 0%)) rotate(var(--angle, 0deg)); transition: transform var(--motion-fast) var(--ease-lift); will-change: transform; }
  .tile__link:hover, .tile__link:focus-visible { transform: translate(var(--dx, 0%), calc(var(--dy, 0%) - 1.5%)) rotate(calc(var(--angle, 0deg) * 0.4)) scale(1.03); }
  .tile__link:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; }
  .tile__link { grid-template-rows: minmax(0, 1fr); overflow: visible; container-type: size; }
  /* Picture clips: fit the cell on whichever axis binds, keeping the image's own aspect ratio (cqw/cqh = the link box). */
  .tile .clip:has(> img) { position: relative; width: min(84cqw, calc(84cqh * var(--ar, 1))); height: auto; aspect-ratio: var(--ar, 1); margin: auto; }
  .tile .clip--typeset, .tile .clip--logo { aspect-ratio: auto; width: 84%; height: 84%; }
  .tile .clip > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .clip--shape { display: grid; place-items: center; aspect-ratio: auto; height: 100%; width: 100%; }
  .tile__slip { max-width: 100%; }
  .tile__text { font-family: var(--font-display); font-size: clamp(0.95rem, 2.2cqw, 1.2rem); line-height: 1.35; text-wrap: pretty; }
  .tile__seal { padding: 10% 14%; border: 2px solid var(--pink-ink); outline: 1px solid var(--pink-ink); outline-offset: -8px; color: var(--ink); }
  .tile__seal-orn { display: block; margin: 0 auto 0.4rem; color: var(--pink-ink); }
  .tile__frame-orn { display: block; margin: 0 auto 0.2rem; color: var(--green); }
  .tile__seal-title { display: block; font-size: clamp(1.1rem, 3cqw, 1.8rem); line-height: 1.05; }
  .tile__seal-n { display: block; margin-top: 0.4em; opacity: 0.8; }
  .tile__frame { padding: 1.2rem; }
  .tile__arch { display: grid; grid-template-rows: 1fr auto; width: 100%; height: 100%; background: var(--green); border-radius: 48% 48% 6px 6px / 40% 40% 6px 6px; padding: 10px; box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--on-dark) 45%, var(--green)), inset 0 0 0 5px var(--green), inset 0 0 0 6px color-mix(in oklab, var(--on-dark) 35%, var(--green)); }
  .tile__arch-window { display: block; border-radius: 46% 46% 0 0 / 40% 40% 0 0; overflow: hidden; }
  .tile__arch-window svg { display: block; width: 100%; height: 100%; }
  .tile__arch-plate { display: grid; place-items: center; background: var(--green); color: var(--on-dark); padding: 0.6rem 0.8rem 0.9rem; text-align: center; }
  .tile__arch-title { font-family: var(--font-display); font-size: clamp(1rem, 2.4cqw, 1.5rem); line-height: 1.1; text-wrap: balance; }
  .tile__frame-inner { display: grid; gap: 0.5rem; text-align: center; }
  .tile__kicker { font-size: 0.65rem; color: var(--fg-muted); }
  .tile__frame-title { font-size: clamp(1.1rem, 3cqw, 1.7rem); line-height: 1.08; text-wrap: balance; }
  .tile__cap { position: absolute; left: 50%; bottom: 0.2rem; transform: translate(-50%, 0); white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; font-size: 0.65rem; color: var(--fg-muted); opacity: 0; transition: opacity var(--motion-fast); pointer-events: none; }
  .tile__link:hover .tile__cap, .tile__link:focus-visible .tile__cap { opacity: 1; }
  @media (hover: none) { .tile__cap { opacity: 1; position: static; transform: none; white-space: normal; text-align: center; margin-top: 0.3rem; } .tile__link { grid-template-rows: minmax(0, 1fr) auto; } .tile .clip:has(> img) { width: min(84cqw, calc(72cqh * var(--ar, 1))); } }
  .wall__pet { grid-column: span 1; grid-row: span 1; display: grid; place-items: center; transform: translate(var(--dx, 0%), var(--dy, 0%)) rotate(var(--angle, 0deg)); }
  .wall__pet .pet img { height: auto; width: 85%; max-height: 100%; object-fit: contain; }
  .wall__pet[data-side='right'] { justify-self: end; }
  @media (max-width: 699px) { .wall__pet { display: none; } .wall__pet[data-first] { display: grid; } }
  @media (prefers-reduced-motion: reduce) { .tile__link { transition: none; } .tile__link:hover { transform: translate(var(--dx, 0%), var(--dy, 0%)) rotate(var(--angle, 0deg)); } }
</style>
