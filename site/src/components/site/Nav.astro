---
import identity from '@theme/identity';
import Pet from '../art/Pet.astro';
const path = Astro.url.pathname;
const pets = identity.placements.nav;
const { minimal = false } = Astro.props as { minimal?: boolean };
---
{minimal ? (
<header class="masthead masthead--min wrap">
  <a class="skip" href="#main">Skip to content</a>
  <a class="brand brand--min" href="/" aria-label={`${identity.site.name} — home`} >{pets.map((p) => <Pet who={p} size="s" class="brand__pet" />)}<span class="brand__hover" aria-hidden="true">{identity.site.name}</span></a>
  <div class="masthead__actions" data-owner-slot></div>
</header>
) : (
<header class="masthead wrap">
  <a class="skip" href="#main">Skip to content</a>
  <div class="masthead__row">
    <a class="brand" href="/" aria-label={`${identity.site.name} — home`}>
      {pets.map((p) => <Pet who={p} size="s" class="brand__pet" />)}
      <span class="brand__name">{identity.site.name}</span>
    </a>
    <nav class="nav" aria-label="Sections">
      <ul>
        <li><a href="/" class="mono" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {identity.nav.map((n) => (
          <li><a href={n.href} class="mono" aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <template data-owner-only>
          <li><a href="/private/" class="mono nav__private">Private</a></li>
        </template>
      </ul>
    </nav>
    <div class="masthead__actions" data-owner-slot></div>
  </div>
  <div class="rule-double"></div>
</header>
)}
<style>
  .masthead { padding-top: var(--space-4); }
  .masthead__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; padding-bottom: var(--space-3); }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .brand__name { font-family: var(--font-display); font-size: var(--step-2); font-weight: 500; line-height: 1; letter-spacing: -0.01em; padding-bottom: 2px; }
  .brand__pet { transform-origin: bottom center; }
  .brand__pet img { height: 64px; width: auto; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.8rem, 2.5vw, 2.2rem); flex-wrap: wrap; }
  .nav a { text-decoration: none; padding: 0.3rem 0; border-bottom: 1px solid transparent; color: var(--ink); text-transform: none; letter-spacing: 0.02em; font-size: 0.95rem; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--green); border-bottom-color: var(--green); }
  .nav__private { color: var(--pink-ink) !important; }
  .masthead--min { display: flex; justify-content: center; position: relative; padding-top: var(--space-4); }
  .masthead--min .masthead__actions { position: absolute; right: 0; top: var(--space-4); }
  .brand--min .brand__pet :global(img) { height: 56px; }
  /* the name slides out to the right of the cats; the pair stays centred, so the cats drift left as it opens */
  .brand--min { display: inline-grid; grid-template-columns: auto 0fr; align-items: center; column-gap: 0; transition: grid-template-columns 260ms var(--ease-lift), column-gap 260ms var(--ease-lift); }
  .brand__hover { min-width: 0; overflow: hidden; white-space: nowrap; font-family: var(--font-display); font-size: var(--step-1); line-height: 1; opacity: 0; transition: opacity 200ms; pointer-events: none; }
  .brand--min:hover, .brand--min:focus-visible { grid-template-columns: auto 1fr; column-gap: 0.8rem; }
  .brand--min:hover .brand__hover, .brand--min:focus-visible .brand__hover { opacity: 1; transition-delay: 60ms; }
  @media (prefers-reduced-motion: reduce) { .brand--min, .brand__hover { transition: none; } }
  .masthead__actions { min-width: 2.5rem; min-height: 1px; }
  /* phones: the sections stay on one line and scroll sideways if an owner link pushes them past the edge */
  @media (max-width: 599px) {
    .brand__name { font-size: var(--step-1); } .masthead__row { align-items: center; }
    .nav { flex-basis: 100%; min-width: 0; }
    .nav ul { flex-wrap: nowrap; gap: 0.7rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-bottom: 2px; }
    .nav ul::-webkit-scrollbar { display: none; }
    .nav a { font-size: 0.84rem; white-space: nowrap; letter-spacing: 0; }
  }
</style>
