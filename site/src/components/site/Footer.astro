---
import identity from '@theme/identity';
import Pet from '../art/Pet.astro';
---
<footer class="footer wrap">
  <div class="rule-double rule-double--fine"></div>
  <div class="footer__row">
    <a class="footer__about" href={identity.footer.about.href}><Pet who="face" size="xs" /> <span class="mono">{identity.footer.about.label}</span></a>
    <a class="mono muted footer__rss" href="/rss.xml">RSS</a>
  </div>
</footer>
<style>
  .footer { margin-top: var(--space-7); padding-bottom: var(--space-5); }
  .footer__row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding-top: var(--space-3); }
  .footer a { text-decoration: none; }
  .footer__about { display: inline-flex; align-items: center; gap: var(--space-2); }
  .footer__about .mono { text-transform: none; letter-spacing: 0.02em; font-size: 0.9rem; }
  .footer__about :global(.pet img) { transition: transform var(--motion-fast) var(--ease-lift); }
  .footer__about:hover :global(.pet img) { animation: wiggle var(--motion-wiggle) var(--ease-lift) 1; transform: translateY(var(--lift)); }
  .footer__rss { text-transform: uppercase; }
  .footer__rss:hover { color: var(--green); }
  @media (prefers-reduced-motion: reduce) { .footer__about:hover :global(.pet img) { animation: none; transform: none; } }
</style>
