---
// Mounted on every public page but only stamped into the DOM for the signed-in owner (see OwnerOnly).
import OwnerOnly from './OwnerOnly.astro';
import CaptureSheet from './CaptureSheet';
import '../../styles/sheet.css';
interface Props { preset?: { mode?: 'thought' | 'link' | 'piece' | 'list' | 'entry'; list?: string; collection?: string } }
const { preset } = Astro.props;
---
<OwnerOnly><CaptureSheet client:only="preact" preset={preset} /></OwnerOnly>
