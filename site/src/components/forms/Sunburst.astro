---
// Fine Art Deco sunburst: rays over a horizon line. Inherits currentColor.
interface Props { class?: string; width?: number }
const { class: cls = '', width = 56 } = Astro.props;
---
<svg class={`orn orn--sunburst ${cls}`} width={width} height={width * 0.55} viewBox="0 0 100 55" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round">
    <path d="M50 44 L50 8" /><path d="M50 44 L28 14" /><path d="M50 44 L72 14" /><path d="M50 44 L14 28" /><path d="M50 44 L86 28" /><path d="M50 44 L8 44" /><path d="M50 44 L92 44" />
    <path d="M50 44 L40 10" opacity=".5" /><path d="M50 44 L60 10" opacity=".5" /><path d="M50 44 L20 20" opacity=".5" /><path d="M50 44 L80 20" opacity=".5" />
  </g>
  <circle cx="50" cy="44" r="4" fill="currentColor" />
  <path d="M10 52 H90" stroke="currentColor" stroke-width="1.2" /><path d="M18 55 H82" stroke="currentColor" stroke-width="0.8" opacity=".6" />
</svg>
