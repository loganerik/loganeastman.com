---
// Quiet reading page: a kicker, the title, meta line, then the prose at reading measure.
import Base from './Base.astro';
import '../styles/prose.css';
import '../styles/editor.css';
interface Props { title: string; description?: string; image?: string; kicker?: string; meta?: string[]; noindex?: boolean; wide?: boolean; feeds?: Array<{ title: string; href: string }> }
const { title, description, image, kicker, meta = [], noindex, wide = false, feeds } = Astro.props;
---
<Base title={title} description={description} image={image} type="article" noindex={noindex} feeds={feeds}>
  <article class={`reading wrap ${wide ? 'reading--wide' : ''}`}>
    <header class="reading__head">
      <slot name="art" />
      <div class="reading__titles">
        <div data-article>
          {kicker && <p class="mono muted reading__kicker">{kicker}</p>}
          <h1 class="reading__title">{title}</h1>
          {meta.length > 0 && <p class="mono muted reading__meta">{meta.map((m, i) => <><span>{m}</span>{i < meta.length - 1 && <span class="sep"> · </span>}</>)}</p>}
        </div>
        <slot name="controls" />
      </div>
    </header>
    <div class="reading__body prose" data-article>
      <slot />
    </div>
    <div data-article><slot name="after" /></div>
  </article>
</Base>
<style>
  .reading { padding-top: var(--space-5); }
  .reading__head { display: grid; gap: var(--space-4); max-width: var(--measure); margin-bottom: var(--space-5); }
  .reading--wide .reading__head { max-width: none; }
  .reading__kicker { margin-bottom: var(--space-2); }
  .reading__title { font-size: var(--step-4); font-weight: 400; }
  .reading__meta { margin-top: var(--space-3); }
  .reading__body { margin-inline: 0; }
</style>
