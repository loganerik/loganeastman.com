---
// Section pages: steady text, artwork moves. Orderly grids and rows.
import Base from './Base.astro';
import OwnerOnly from '../components/private/OwnerOnly.astro';
interface Props { title: string; description?: string; kicker?: string; count?: number; action?: { label: string; href: string }; feeds?: Array<{ title: string; href: string }>; noindex?: boolean; preset?: { mode?: 'thought' | 'link' | 'piece' | 'list' | 'entry'; list?: string; collection?: string }; quiet?: boolean; image?: string }
const { title, description, kicker, count, action, feeds, noindex, preset, quiet = false, image } = Astro.props;
---
<Base title={title} description={description} feeds={feeds} noindex={noindex} preset={preset} image={image}>
  <div class="section wrap">
    <header class={`section__head ${quiet ? 'section__head--quiet' : ''}`}>
      <div>
        {kicker && !quiet && <p class="mono muted">{kicker}</p>}
        <h1 class={quiet ? 'vh' : undefined}>{title}{typeof count === 'number' && !quiet && <span class="mono muted section__count"> {count}</span>}</h1>
        <slot name="intro" />
      </div>
      <div class="section__action">
        {action && <OwnerOnly><a class="btn btn--soft" href={action.href}>{action.label}</a></OwnerOnly>}
        <slot name="action" />
      </div>
    </header>
    <slot />
  </div>
</Base>
<style>
  .section { padding-top: var(--space-5); }
  .section__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .section__head--quiet { align-items: center; margin-bottom: var(--space-4); }
  .section__count { font-size: var(--mono-size); vertical-align: super; margin-left: 0.4em; }
  .section__action { min-height: 2.4rem; display: flex; align-items: center; gap: var(--space-2); }
</style>
