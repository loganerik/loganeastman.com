---
import Head from '../components/site/Head.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import OwnerTools from '../components/private/OwnerTools.astro';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; feeds?: Array<{ title: string; href: string }>; noindex?: boolean; class?: string; preset?: { mode?: 'thought' | 'link' | 'piece' | 'list' | 'entry'; list?: string; collection?: string }; noFab?: boolean }
const { class: cls = '', preset, noFab = false, ...head } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Head {...head} />
  </head>
  <body class={cls}>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!noFab && <OwnerTools preset={preset} />}
    <script src="../components/private/owner-gate.ts"></script>
    <script src="../components/art/logo-tone.ts"></script>
  </body>
</html>
